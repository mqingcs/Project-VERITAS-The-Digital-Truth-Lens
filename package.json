    "d3": "^7.9.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-force-graph-2d": "^1.29.0",
    "vis-data": "^8.0.3",
    "vis-network": "^10.0.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "^0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "svgo": "^3.3.2",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
