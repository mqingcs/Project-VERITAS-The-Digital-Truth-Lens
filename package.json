{
  "name": "veritas",
  "displayName": "Veritas: Autonomous Multi-Agent Truth Engine",
  "version": "0.0.1",
  "description": "A multi-agent browser reality augmentation system for truth verification",
  "author": "Mu Qing",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@google/generative-ai": "^0.24.1",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-force-graph-2d": "^1.29.0",
    "react-force-graph-3d": "^1.26.0",
    "three": "^0.160.0",
    "three-spritetext": "^1.10.0",
    "vis-data": "^8.0.3",
    "vis-network": "^10.0.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "^0.0.258",
    "@types/jest": "^30.0.0",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "svgo": "^3.3.2",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "storage",
      "scripting",
      "sidePanel",
      "contextMenus"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "commands": {
      "_execute_action": {
        "suggested_key": {
          "default": "Alt+S",
          "mac": "Alt+S",
          "windows": "Alt+S"
        }
      },
      "veritas-analyze": {
        "suggested_key": {
          "default": "Alt+V",
          "mac": "Alt+V",
          "windows": "Alt+V"
        },
        "description": "Analyze current page with Veritas"
      },
      "veritas-commander": {
        "suggested_key": {
          "default": "Alt+C",
          "mac": "Alt+C",
          "windows": "Alt+C"
        },
        "description": "Open Veritas Commander"
      }
    }
  }
}